  <div class="intro">
    <h1>Slug AI</h1>
    <p class="pitch">Save 3 to 4x using Slug over realtime inference providers for jobs that can wait</p>
  </div>
  <script is:inline>
    const slug = document.querySelector('.slug');
    const copy = slug.cloneNode(true);
    copy.setAttribute('aria-hidden', 'true');
    slug.after(copy);
  </script>
</body>

</html>