---
import '../styles/fonts.css';
---

<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Slug AI</title>
  <meta name="description"
    content="Save 3 to 4x using Slug over realtime inference providers for jobs that can wait">
  <style is:inline>
    :root {
      --paper: #f5f1e3;
      --ink: #211e16;
      --slug: #7a6c00;
    }

    html {
      /* Stops phones enlarging the slug's small text. */
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }

    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-body);
    }

    .track {
      position: relative;
      width: 100%;
      margin-block: auto;
      overflow: hidden;
    }

    .slug {
      display: grid;
      width: max-content;
      color: var(--slug);
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      /* Narrower than the screen, so the wrapped copy never runs into the slug. */
      font-size: min(9.5px, 1.55vw);
      animation: crawl 43s linear infinite;
    }

    /* The copy added below sits one screen behind, so the slug wraps around the edge. */
    .slug+.slug {
      position: absolute;
      top: 0;
      left: -100vw;
    }

    .frame {
      grid-area: 1 / 1;
      margin: 0;
      font: inherit;
      line-height: 1.1;
      animation: swap 1.8s steps(1) infinite;
    }

    .frame:nth-child(2) {
      animation-delay: -1.35s;
    }

    .frame:nth-child(3) {
      animation-delay: -0.9s;
    }

    .frame:nth-child(4) {
      animation-delay: -0.45s;
    }

    @keyframes crawl {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(100vw);
      }
    }

    @keyframes swap {

      25%,
      100% {
        visibility: hidden;
      }
    }

    .intro {
      padding: 24px;
      font-size: 17px;
    }

    h1 {
      margin: 0 0 8px;
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
    }

    .pitch {
      max-width: 42ch;
      margin: 0 0 12px;
      line-height: 1.5;
    }

    .top-nav {
      display: flex;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 8px 20px;
      padding: 24px;
      font-size: 16px;
    }

    .top-nav a {
      color: var(--ink);
      text-decoration: none;
    }

    .top-nav a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .top-nav a:focus-visible {
      outline: 2px solid var(--slug);
      outline-offset: 3px;
    }

    @media (max-width: 600px) {
      .slug {
        animation-duration: 30s;
      }

      .top-nav {
        padding: 16px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .slug {
        /* Centers the body rather than the art, which includes the trail behind it. */
        margin-left: 50%;
        transform: translateX(-59%);
        animation: none;
      }

      .slug+.slug {
        display: none;
      }

      .frame {
        animation: none;
      }

      .frame+.frame {
        display: none;
      }
    }
  </style>
</head>

<body>
  <nav class="top-nav" aria-label="Main">
    <a href="/api/">API</a>
    <a href="/blog/">Blog</a>
    <a href="mailto:shrey@utexas.edu">Email us</a>
  </nav>
