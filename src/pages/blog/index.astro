---
import Layout from '../../layouts/Layout.astro';
import { formatDate, getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Layout title="Blog | Slug AI" description="Notes from building cheap batch inference at Slug AI.">
  <h1>Blog</h1>
  {
    posts.length === 0 ? (
      <p>No posts yet.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <time class="post-date" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            {post.data.draft && <span class="tag"> draft</span>}
            <br />
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p class="muted">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
