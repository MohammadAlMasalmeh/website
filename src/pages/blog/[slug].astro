---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Slug AI`} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <time class="post-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    {post.data.draft && <span class="tag"> draft</span>}
    <div class="prose">
      <Content />
    </div>
  </article>
  <p><a href="/blog/">&larr; All posts</a></p>
</Layout>
